{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Constellation Conversation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "description",
    "date",
    "published",
    "participants",
    "messages"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "published": {
      "type": "boolean"
    },
    "demo": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "awaiting-source",
        "complete"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cover": {
      "type": "string"
    },
    "editorial": {
      "type": "string"
    },
    "participants": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "avatars": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "speaker",
          "body"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "speaker": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "effect": {
            "enum": [
              "glow",
              "float",
              "celebrate"
            ]
          },
          "sticker": {
            "type": "string"
          },
          "dice": {
            "type": "string"
          },
          "reactions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "emoji",
                "count"
              ],
              "properties": {
                "emoji": {
                  "type": "string"
                },
                "count": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "image",
                    "audio",
                    "video",
                    "embed",
                    "link",
                    "download"
                  ]
                },
                "src": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "alt": {
                  "type": "string"
                },
                "caption": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "poster": {
                  "type": "string"
                },
                "transcript": {
                  "type": "string"
                },
                "captions": {
                  "type": "string"
                }
              }
            }
          },
          "uuid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "start",
        "nodes"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "start": {
          "type": "string"
        },
        "nodes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "body",
              "actions"
            ],
            "properties": {
              "body": {
                "type": "string"
              },
              "actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "to": {
                      "type": "string"
                    },
                    "roll": {
                      "type": "string"
                    },
                    "target": {
                      "type": "number"
                    },
                    "pass": {
                      "type": "string"
                    },
                    "fail": {
                      "type": "string"
                    },
                    "set": {
                      "type": "object",
                      "additionalProperties": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "string",
                            "maxLength": 2000
                          }
                        ]
                      }
                    },
                    "when": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "variable",
                        "op",
                        "value"
                      ],
                      "properties": {
                        "variable": {
                          "type": "string"
                        },
                        "op": {
                          "enum": [
                            ">",
                            ">=",
                            "<",
                            "<=",
                            "="
                          ]
                        },
                        "value": {
                          "anyOf": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "string",
                              "maxLength": 2000
                            }
                          ]
                        }
                      }
                    },
                    "input": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "variable",
                        "label"
                      ],
                      "properties": {
                        "variable": {
                          "type": "string",
                          "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,39}$"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "placeholder": {
                          "type": "string"
                        },
                        "maxLength": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 2000
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "previous": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "next": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "feedback": {
      "type": "boolean"
    }
  }
}
