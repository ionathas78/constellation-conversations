{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Constellation local feedback session v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "messages"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "messages": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uuid",
          "threadUUID",
          "replyTo",
          "speaker",
          "body",
          "createdAt"
        ],
        "properties": {
          "uuid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "threadUUID": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "replyTo": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "speaker": {
            "const": "session-reader"
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "createdAt": {
            "type": "string"
          }
        }
      }
    }
  }
}
